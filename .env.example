# Clave: https://console.cloud.google.com/google/maps-apis
# Activa "Places API (New)" en tu proyecto y crea una clave de API.
GOOGLE_PLACES_API_KEY=

# Mismo valor que la clave de Places (o otra con Maps JavaScript API activa).
# Necesaria en el cliente para el mapa de resultados; usa el prefijo NEXT_PUBLIC_.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# MongoDB (prospectos guardados, listas, etiquetas). Opcional: nombre de base distinto.
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?appName=lead-scraper
# MONGODB_DB_NAME=lead_scraper

# OpenAI: generación del mensaje de contacto WhatsApp (solo servidor).
# OPENAI_API_KEY=sk-...
# Opcional: modelo (por defecto gpt-4o-mini).
# OPENAI_OUTREACH_MODEL=gpt-4o-mini
